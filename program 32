#include <stdio.h>

int main() {
    int pages[50], frames[10], time[10];
    int n, f, i, j, pos, least, count = 0;
    int pageFaults = 0, hits = 0, found;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    // Initialize frames
    for (i = 0; i < f; i++) {
        frames[i] = -1;
        time[i] = 0;
    }

    printf("\nPage\tFrames\t\tStatus\n");

    for (i = 0; i < n; i++) {
        found = 0;

        // Check if page is already in frames
        for (j = 0; j < f; j++) {
            if (frames[j] == pages[i]) {
                found = 1;
                hits++;
                count++;
                time[j] = count;   // Update recent use
                break;
            }
        }

        if (!found) {
            // Find empty frame
            pos = -1;
            for (j = 0; j < f; j++) {
                if (frames[j] == -1) {
                    pos = j;
                    break;
                }
            }

            // If no empty frame, replace least recently used page
            if (pos == -1) {
                least = time[0];
                pos = 0;
                for (j = 1; j < f; j++) {
                    if (time[j] < least) {
                        least = time[j];
                        pos = j;
                    }
                }
            }

            count++;
            frames[pos] = pages[i];
            time[pos] = count;
            pageFaults++;
        }

        printf("%d\t", pages[i]);
        for (j = 0; j < f; j++) {
            if (frames[j] != -1)
                printf("%d ", frames[j]);
            else
                printf("- ");
        }

        if (found)
            printf("\tHit\n");
        else
            printf("\tMiss\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits = %d\n", hits);

    return 0;
}


